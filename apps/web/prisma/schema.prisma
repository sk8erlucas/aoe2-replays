// Only the parsed JSON is stored (gzip, ~10x smaller), never the .aoe2record.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Replay {
  /// Public link id: 128 random bits, base64url.
  id              String    @id
  /// SHA-256 of the management token; the token itself is only shown to the uploader.
  manageTokenHash String    @map("manage_token_hash")
  isPublic        Boolean   @default(false) @map("is_public")
  createdAt       DateTime  @default(now()) @map("created_at")
  /// Null means it never expires.
  expiresAt       DateTime? @map("expires_at")
  uploaderIpHash  String?   @map("uploader_ip_hash")
  /// Account it was uploaded with (or saved to). Such replays don't expire and
  /// go with the account.
  userId          String?   @map("user_id")
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileName      String? @map("file_name")
  schemaVersion Int     @map("schema_version")
  gameVersion   String  @map("game_version")
  saveVersion   Float   @map("save_version")
  mapName       String? @map("map_name")
  mapSize       Int     @map("map_size")
  durationMs    Int     @map("duration_ms")
  /// [{ number, name, civilization, color_id, team_id }]
  players       Json

  /// Parser output, gzip-compressed JSON.
  data      Bytes
  dataBytes Int   @map("data_bytes")

  @@index([expiresAt])
  @@index([uploaderIpHash, createdAt])
  @@index([userId, createdAt])
  @@map("replays")
}

/// Online matches downloaded from Microsoft's replay service. Public by nature
/// (anyone can download them), stored once per match id.
model Match {
  /// The game's match id.
  id              String   @id
  /// Profile whose replay copy was downloaded.
  sourceProfileId String   @map("source_profile_id")
  importedAt      DateTime @default(now()) @map("imported_at")
  /// Last time someone opened it (updated at most once a day). Matches nobody
  /// opened in MATCH_TTL_DAYS are deleted: anyone can make the site store one.
  lastViewedAt    DateTime @default(now()) @map("last_viewed_at")

  schemaVersion Int     @map("schema_version")
  gameVersion   String  @map("game_version")
  saveVersion   Float   @map("save_version")
  mapName       String? @map("map_name")
  mapSize       Int     @map("map_size")
  durationMs    Int     @map("duration_ms")
  players       Json

  /// Parser output, gzip-compressed JSON.
  data      Bytes
  dataBytes Int   @map("data_bytes")

  @@index([importedAt])
  @@index([lastViewedAt])
  @@map("matches")
}

/// Accounts are optional: uploading, watching and searching stay anonymous.
model User {
  /// 128 random bits, base64url.
  id           String   @id
  /// Lowercase. Never shown on public pages.
  email        String   @unique
  /// scrypt, with its parameters and salt (see src/lib/password.ts).
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  /// The player this account says it is. Not verified: anyone can pick any
  /// profile, so it only drives this user's own notifications.
  aoeProfileId   String?   @map("aoe_profile_id")
  aoeProfileName String?   @map("aoe_profile_name")
  aoeLinkedAt    DateTime? @map("aoe_linked_at")

  /// Last time new matches were looked up; limits requests to aoe2companion.
  notificationsCheckedAt DateTime? @map("notifications_checked_at")

  sessions      Session[]
  follows       FollowedPlayer[]
  notifications Notification[]
  replays       Replay[]

  @@map("users")
}

model Session {
  /// SHA-256 of the cookie's token; the token itself is only in the browser.
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model FollowedPlayer {
  userId    String   @map("user_id")
  profileId String   @map("profile_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, profileId])
  @@map("followed_players")
}

/// A finished match worth watching, one per user and match.
model Notification {
  userId          String    @map("user_id")
  matchId         String    @map("match_id")
  /// The linked or followed player who played it (their copy gets downloaded).
  profileId       String    @map("profile_id")
  playerName      String    @map("player_name")
  /// The user's own match, as opposed to a followed player's.
  mine            Boolean
  won             Boolean?
  mapName         String?   @map("map_name")
  leaderboardName String?   @map("leaderboard_name")
  finishedAt      DateTime  @map("finished_at")
  readAt          DateTime? @map("read_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, matchId])
  @@index([userId, finishedAt(sort: Desc)])
  @@index([finishedAt])
  @@map("notifications")
}
