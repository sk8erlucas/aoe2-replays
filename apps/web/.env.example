# Postgres connection string. Locally: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgresql://aoe2:aoe2@localhost:5433/aoe2replays

# URL of the parser service (services/parser). Only used server side.
PARSER_URL=http://127.0.0.1:8000

# Days until an uploaded replay is deleted. 0 = never.
REPLAY_TTL_DAYS=30

# Days an online match stays stored after the last time someone opened it. 0 = forever.
MATCH_TTL_DAYS=90

# Max uploads per IP per hour.
UPLOADS_PER_HOUR=20

# Player searches per IP per minute, and online matches downloaded from Microsoft
# per IP and for the whole site, per hour. 0 = no limit.
SEARCHES_PER_MINUTE=60
MATCH_IMPORTS_PER_HOUR=20
MATCH_IMPORTS_PER_HOUR_GLOBAL=300

# Accounts created per IP per hour, and login attempts per IP and per email every
# 15 minutes. 0 = no limit.
REGISTRATIONS_PER_HOUR=10
LOGINS_PER_15_MINUTES=20

# Players an account can follow, and checks for new matches per minute for the
# whole site (each one is up to two requests to aoe2companion).
MAX_FOLLOWS=20
MAX_FAVORITES=500
# Replays an account keeps (they don't expire while the account exists). 0 = no limit.
MAX_ACCOUNT_REPLAYS=200
NOTIFICATION_CHECKS_PER_MINUTE=120

# Random secret used to hash uploader IPs (generate with: openssl rand -hex 32).
IP_HASH_SECRET=change-me

# Public address of the site (canonical links, social previews, sitemap). Default: the official site.
# SITE_URL=http://localhost:3000
